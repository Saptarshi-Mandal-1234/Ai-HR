GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
PORT=3000
GEMINI_TIMEOUT_MS=45000

# Leave DATABASE_URL empty for local JSON storage, or set it for PostgreSQL.
DATABASE_URL=
DATABASE_SSL=auto
AIHR_ORGANIZATION_ID=default
# Set true once to import data/hr-store.json into an empty PostgreSQL database.
AIHR_IMPORT_JSON=false

AIHR_AUTH_REQUIRED=false
AIHR_SESSION_DAYS=7
AIHR_INVITATION_HOURS=72
AIHR_LOG_REQUESTS=false
AIHR_APP_BASE_URL=http://localhost:3000
AIHR_ALLOWED_ORIGIN=http://localhost:3000
AIHR_ADMIN_TOKEN=replace_with_a_long_random_admin_token
AIHR_HR_MANAGER_TOKEN=replace_with_a_long_random_hr_manager_token
AIHR_RECRUITER_TOKEN=replace_with_a_long_random_recruiter_token
AIHR_EMPLOYEE_TOKEN=replace_with_a_long_random_employee_token
AIHR_AUDITOR_TOKEN=replace_with_a_long_random_auditor_token

AIHR_RATE_LIMIT=120
AIHR_AI_RATE_LIMIT=20
AIHR_RATE_LIMIT_WINDOW_MS=60000
AIHR_BODY_LIMIT_BYTES=1000000

# Optional SMTP invitation delivery. Without this, admins can copy invitation links.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional signed HTTPS incident webhook.
AIHR_ALERT_WEBHOOK_URL=
AIHR_ALERT_WEBHOOK_SECRET=

# Optional outbound integration adapters. Use provider-issued HTTPS webhook URLs.
AIHR_CALENDAR_WEBHOOK_URL=
AIHR_HRIS_WEBHOOK_URL=
AIHR_ATS_WEBHOOK_URL=
AIHR_COLLABORATION_WEBHOOK_URL=
AIHR_PAYROLL_WEBHOOK_URL=
AIHR_INTEGRATION_WEBHOOK_SECRET=

# PostgreSQL backup encryption. Generate 32 random bytes encoded as base64url.
AIHR_BACKUP_KEY=
AIHR_BACKUP_DIR=backups
